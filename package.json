{
  "name": "roguelike",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,client -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "check": "tsx check.ts",
    "sprites": "node tools/make-sprites.mjs",
    "start": "tsx src/server/index.ts",
    "preview": "npm run build && npm start"
  },
  "dependencies": {
    "@colyseus/sdk": "^0.18.9",
    "colyseus": "^0.18.10",
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": ">=20"
  }
}
